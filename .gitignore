# ==============================================================================
# ShopSphere - Root .gitignore
# ==============================================================================

# Environment files & Secrets
.env
.env.*
!.env.example
*.env
*.env.*
!*.env.example
Backend/.env
Backend/.env.*
!Backend/.env.example
Frontend/.env
Frontend/.env.*
!Frontend/.env.example

# Python / Django
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite3
db.sqlite3
Backend/staticfiles/
Backend/static/
!Backend/media/products/
!Backend/media/products/*

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
Backend/venv/
Backend/.venv/

# Frontend & Node
node_modules/
Frontend/node_modules/
dist/
Frontend/dist/
dist-ssr/
Frontend/dist-ssr/
.next/
out/
build/
.turbo
.parcel-cache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.sublime-workspace
*.sublime-project