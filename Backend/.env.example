# ==============================================================================
# ShopSphere Backend Environment Configuration (.env.example)
# Copy this file to .env and configure the appropriate values before running.
# ==============================================================================

# Django Secret Key (Generate a secure key for production)
SECRET_KEY=django-insecure-shopsphere-hackathon-demo-key-change-in-production

# Debug Mode (True for development, False for production)
DEBUG=True

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL or SQLite)
# Example: postgresql://user:password@ep-sample-12345.us-east-2.aws.neon.tech/shopsphere?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# Cloudinary Storage Configuration (For Product Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Google Gemini AI (For AI Shopping Assistant / Chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email Configuration (SMTP for OTP Verification & Order Notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_email_app_password
DEFAULT_FROM_EMAIL=ShopSphere <noreply@shopsphere.com>

# Frontend URL (For CORS & Password Reset / Verification Links)
FRONTEND_URL=http://localhost:5173
